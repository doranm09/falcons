# Database
POSTGRES_DB=postgres
POSTGRES_NAME=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Django
DJANGO_SETTINGS_MODULE=cyber_pen_test.settings
DJANGO_SECRET_KEY=replace_me

# Celery
CELERY_BROKER_URL=redis://redis:6379/0

# MiniMega controls
MINIMEGA_EXECUTION_ENABLED=0
MINIMEGA_SCRIPT_DIR=/tmp/cybertwin_minimega
MINIMEGA_ALLOW_RESET=0
MINIMEGA_ALLOW_KILL=0
MINIMEGA_RESET_COMMAND="clear vm"
MINIMEGA_KILL_COMMAND="quit"

# OpenVAS / GVM
GVM_HOST=openvas
GVM_PORT=9390
GVM_USER=admin
GVM_PASS=admin
GVM_SOCKET_PATH=/opt/gvm-run/gvmd.sock

# Risk Assessment API
RISK_ASSESSMENT_API_URL=http://risk-assessment:7890
